# Copy to ~/.config/simhammer/simhammer.env and keep that file private.
SIMC_ENABLED_BRANCHES=weekly,nightly
SIMC_CHECK_INTERVAL=3600

# Optional: enable password-based access to /admin.
# ADMIN_PASSWORD=replace-with-your-own-password

# Optional: direct Blizzard equipment imports. Configure both values and
# uncomment the matching secret-file Volume in simhammer.container.
# BLIZZARD_CLIENT_ID=replace-with-your-battle-net-client-id
# BLIZZARD_CLIENT_SECRET_FILE=/run/secrets/blizzard-client-secret
